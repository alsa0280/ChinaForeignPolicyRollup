<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="700" viewBox="0 0 1440 700" xmlns:c2pa="http://c2pa.org/manifest">
<defs><marker id="a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#333333"/></marker></defs>
<rect width="1440" height="700" fill="#fbfaf7"/>
<text x="20" y="32" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">How the roll-up works (n8n prototype)</text>
<rect x="212" y="172" width="1186" height="306" rx="4" fill="none" stroke="#8a8a8a" stroke-width="1.2" stroke-dasharray="6 4"/>
<text x="332" y="192" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="italic" text-anchor="start" fill="#666666">n8n workflow, running in Docker</text>
<rect x="230" y="205" width="170" height="140" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.2"/>
<text x="242" y="231" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="15" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">1. Collect</text>
<text x="242" y="257" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">Read the source list,</text>
<text x="242" y="275" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">fetch each page or feed,</text>
<text x="242" y="293" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">parse the text, hash it,</text>
<text x="242" y="311" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">skip articles already seen.</text>
<rect x="475" y="205" width="170" height="140" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.2"/>
<text x="487" y="231" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="15" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">2. Extract</text>
<text x="487" y="257" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">Add the 28 opportunities</text>
<text x="487" y="275" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">to the prompt and ask the</text>
<text x="487" y="293" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">local model for claims,</text>
<text x="487" y="311" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">each with a quote.</text>
<rect x="720" y="205" width="170" height="140" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.2"/>
<text x="732" y="231" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="15" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">3. Validate</text>
<text x="732" y="257" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">Keep a claim only if the</text>
<text x="732" y="275" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">opportunity ID exists and</text>
<text x="732" y="293" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">the quote is in the</text>
<text x="732" y="311" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">article. Scores set to 1-5.</text>
<rect x="965" y="205" width="170" height="140" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.2"/>
<text x="977" y="231" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="15" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">4. Track state</text>
<text x="977" y="257" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">Turn claims into events,</text>
<text x="977" y="275" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">compare with the current</text>
<text x="977" y="293" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">state: insert, update, or</text>
<text x="977" y="311" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">flag a conflict.</text>
<rect x="1210" y="205" width="170" height="140" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.2"/>
<text x="1222" y="231" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="15" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">5. Report</text>
<text x="1222" y="257" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">Write the daily change</text>
<text x="1222" y="275" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">note as a markdown</text>
<text x="1222" y="293" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">draft for a person to</text>
<text x="1222" y="311" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">review.</text>
<line x1="402" y1="275" x2="473" y2="275" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<line x1="647" y1="275" x2="718" y2="275" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<line x1="892" y1="275" x2="963" y2="275" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<line x1="1137" y1="275" x2="1208" y2="275" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="220" y="56" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="italic" text-anchor="start" fill="#666666">Repo files, mounted into the container at /home/node/.n8n-files</text>
<rect x="220" y="70" width="190" height="44" rx="2" fill="#ffffff" stroke="#777777" stroke-width="1.2"/>
<text x="315" y="97" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">data/source_registry.json</text>
<line x1="315" y1="114" x2="315" y2="203" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="323" y="150" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">source list</text>
<rect x="465" y="70" width="190" height="44" rx="2" fill="#ffffff" stroke="#777777" stroke-width="1.2"/>
<text x="560" y="97" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">data/opportunities.json</text>
<line x1="560" y1="114" x2="560" y2="203" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="568" y="150" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">28 opportunities</text>
<rect x="10" y="240" width="160" height="70" rx="2" fill="#eeeeee" stroke="#888888" stroke-width="1.2" stroke-dasharray="5 4"/>
<text x="90" y="270" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12.5" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">Websites and</text>
<text x="90" y="288" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12.5" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">RSS feeds</text>
<line x1="172" y1="275" x2="228" y2="275" stroke="#333333" stroke-width="1.4" stroke-dasharray="5 4" marker-end="url(#a)" marker-start="url(#a)"/>
<text x="201" y="267" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="middle" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">fetch</text>
<rect x="222" y="388" width="100" height="44" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.2"/>
<text x="272.0" y="415" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">documents</text>
<rect x="332" y="388" width="110" height="44" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.2"/>
<text x="387.0" y="415" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">source_health</text>
<line x1="272" y1="347" x2="272" y2="386" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="278" y="372" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">new articles</text>
<line x1="387" y1="347" x2="387" y2="386" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="393" y="372" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">ok / failed</text>
<rect x="755" y="388" width="100" height="44" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.2"/>
<text x="805.0" y="415" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">ai_claims</text>
<line x1="805" y1="347" x2="805" y2="386" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="811" y="372" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">per article</text>
<rect x="940" y="388" width="100" height="44" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.2"/>
<text x="990.0" y="415" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">event</text>
<rect x="1065" y="388" width="120" height="44" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.2"/>
<text x="1125.0" y="415" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">current_state</text>
<line x1="990" y1="347" x2="990" y2="386" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="996" y="372" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">one per claim</text>
<line x1="1125" y1="347" x2="1125" y2="386" stroke="#333333" stroke-width="1.4" marker-end="url(#a)" marker-start="url(#a)"/>
<text x="1131" y="372" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">read, then update</text>
<text x="222" y="466" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="italic" text-anchor="start" fill="#666666">Duplicates are caught by a hash of the article text.</text>
<text x="700" y="452" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="italic" text-anchor="start" fill="#666666">AI output is not trusted: claims with an unknown ID</text>
<text x="700" y="468" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="italic" text-anchor="start" fill="#666666">or a quote not found in the article are dropped.</text>
<rect x="470" y="530" width="180" height="60" rx="2" fill="#eeeeee" stroke="#888888" stroke-width="1.2" stroke-dasharray="5 4"/>
<text x="560" y="556" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12.5" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">Ollama on the host</text>
<text x="560" y="574" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="12" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">qwen2.5:7b</text>
<line x1="560" y1="347" x2="560" y2="528" stroke="#333333" stroke-width="1.4" stroke-dasharray="5 4" marker-end="url(#a)" marker-start="url(#a)"/>
<text x="568" y="505" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">prompt out, JSON claims back</text>
<text x="568" y="520" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="10.5" font-style="italic" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">host.docker.internal:11434</text>
<rect x="1195" y="530" width="200" height="44" rx="2" fill="#ffffff" stroke="#777777" stroke-width="1.2"/>
<text x="1295" y="557" font-family="Liberation Mono, Consolas, Courier New, monospace" font-size="11" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">output/change_note.md</text>
<line x1="1295" y1="347" x2="1295" y2="528" stroke="#333333" stroke-width="1.4" marker-end="url(#a)"/>
<text x="1303" y="505" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11" font-style="normal" text-anchor="start" fill="#666666" stroke="#fbfaf7" stroke-width="4" paint-order="stroke">draft</text>
<rect x="1195" y="622" width="200" height="50" rx="2" fill="#ffffff" stroke="#777777" stroke-width="1.2" stroke-dasharray="5 4"/>
<text x="1295" y="644" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12.5" font-weight="normal" font-style="normal" text-anchor="middle" fill="#222222">Human review</text>
<text x="1295" y="661" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="normal" text-anchor="middle" fill="#666666">(planned, not built yet)</text>
<line x1="1295" y1="576" x2="1295" y2="620" stroke="#333333" stroke-width="1.4" stroke-dasharray="5 4" marker-end="url(#a)"/>
<text x="20" y="520" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="12" font-weight="bold" font-style="normal" text-anchor="start" fill="#222222">Key</text>
<rect x="20" y="534" width="26" height="14" rx="2" fill="#e6edf2" stroke="#48697f" stroke-width="1.1"/>
<text x="56" y="546" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">n8n step</text>
<rect x="20" y="558" width="26" height="14" rx="2" fill="#f4ecd8" stroke="#9a8445" stroke-width="1.1"/>
<text x="56" y="570" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">n8n data table</text>
<rect x="20" y="582" width="26" height="14" rx="2" fill="#ffffff" stroke="#777777" stroke-width="1.1"/>
<text x="56" y="594" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">file in the repo</text>
<rect x="20" y="606" width="26" height="14" rx="2" fill="#eeeeee" stroke="#888888" stroke-width="1.1" stroke-dasharray="5 4"/>
<text x="56" y="618" font-family="Liberation Sans, Arial, Helvetica, sans-serif" font-size="11.5" font-weight="normal" font-style="normal" text-anchor="start" fill="#222222">outside Docker</text>
<metadata><c2pa:manifest></c2pa:manifest></metadata></svg>